#include <stdio.h>
#include <stdlib.h>

typedef struct Node {
    char data;
    struct Node* next;
} Node;

void push(Node** top, char data) {
    Node* newNode = (Node*)malloc(sizeof(Node));
    newNode->data = data;
    newNode->next = *top;
    *top = newNode;
}

char pop(Node** top) {
    if (*top == NULL) return '\0'; // Return null character if stack is empty
    Node* temp = *top;
    char data = temp->data;
    *top = (*top)->next;
    free(temp);
    return data;
}

int isBalanced(char* expression) {
    Node* stack = NULL;

    for (int i = 0; expression[i] != '\0'; i++) {
        char current = expression[i];

        if (current == '(') {
            push(&stack, current);
        } else if (current == ')') {
            if (pop(&stack) != '(') {
                return 0;  // Not balanced if there is no matching '('
            }
        }
    }

    return stack == NULL; // If stack is empty, it's balanced
}

int main() {
    char expression[100];
    printf("Enter an expression with parentheses: ");
    scanf("%s", expression);

    if (isBalanced(expression)) {
        printf("The parentheses are balanced.\n");
    } else {
        printf("The parentheses are not balanced.\n");
    }

    return 0;
}